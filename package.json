{
  "name": "dm-manager",
  "version": "1.12.4",
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.1.2",
    "@fortawesome/free-solid-svg-icons": "^6.1.2",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@tasoskakour/react-use-oauth2": "^1.0.11",
    "axios": "^1.8.2",
    "bootstrap": "^5.2.0",
    "cheerio": "^1.0.0-rc.12",
    "connect-ensure-login": "^0.1.1",
    "connect-mongo": "^4.6.0",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "dotenv-expand": "^5.1.0",
    "express": "^5.2.1",
    "express-session": "^1.18.1",
    "fs-extra": "^11.3.5",
    "he": "^1.2.0",
    "jsonwebtoken": "^9.0.0",
    "luxon": "^3.4.4",
    "moment": "^2.29.4",
    "mongoose": "^6.13.8",
    "mongoose-permissions": "^1.0.0",
    "mongoose-schema-jsonschema": "^2.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "nodemailer": "^8.0.5",
    "nodemon": "^3.1.14",
    "passport": "^0.6.0",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^7.1.2",
    "passport-oauth2": "^1.6.1",
    "pdfkit": "^0.17.2",
    "react": "^18.2.0",
    "react-bootstrap": "^2.5.0",
    "react-bootstrap-icons": "^1.10.3",
    "react-bootstrap-typeahead": "^6.0.0",
    "react-csv": "^2.2.2",
    "react-datepicker": "^4.8.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-query": "^3.39.2",
    "react-router-dom": "^6.3.0",
    "react-to-print": "^2.14.7",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "showdown": "^2.1.0",
    "tailwindcss": "^3.0.2",
    "three": "^0.152.2"
  },
  "scripts": {
    "server": "nodemon --watch server server/run-server.js",
    "command": "node server/command.js",
    "worker": "nodemon --watch server server/worker.js",
    "clear-sessions": "node server/command.js clear-sessions",
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test-api": "node server/test.js",
    "test": "jest --passWithNoTests",
    "test-react": "vitest"
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "setupFiles": [
      "react-app-polyfill/jsdom"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ],
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(js|jsx|mjs|cjs|ts|tsx)$": "<rootDir>/config/jest/babelTransform.js",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|mjs|cjs|ts|tsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "modulePaths": [],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy",
      "axios": "axios/dist/node/axios.cjs"
    },
    "moduleFileExtensions": [
      "web.js",
      "js",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ],
    "watchPlugins": [
      "jest-watch-typeahead/filename",
      "jest-watch-typeahead/testname"
    ],
    "resetMocks": true
  },
  "_proxy": "http://localhost:8000",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.20.12",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@vitejs/plugin-react": "^4.2.1",
    "chai": "^4.3.6",
    "chai-as-promised": "^7.1.1",
    "jest": "^30.3.0",
    "mocha": "^7.2.0",
    "postcss": "^8.4.4",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-normalize": "^10.0.1",
    "postcss-preset-env": "^7.0.1",
    "sass": "^1.69.5",
    "supertest": "^6.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.0.4",
    "web-vitals": "^5.3.0"
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  }
}
